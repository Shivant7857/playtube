<?xml version="1.0" encoding="utf-8"?>
<!-- Material theme overlay is required, otherwise Chip crashes outside a Material theme -->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:theme="@style/Theme.MaterialComponents.DayNight.Bridge"
    android:textColor="@color/home_chip_text"
    android:textSize="13sp"
    android:fontFamily="sans-serif-medium"
    android:checkable="true"
    android:elevation="0dp"
    app:chipBackgroundColor="@color/home_chip_bg"
    app:chipCornerRadius="8dp"
    app:chipStrokeWidth="0dp"
    app:chipStrokeColor="@android:color/transparent"
    app:chipMinHeight="32dp"
    app:chipStartPadding="12dp"
    app:chipEndPadding="12dp"
    app:chipIconVisible="false"
    app:checkedIconVisible="false"
    app:ensureMinTouchTargetSize="false"
    app:rippleColor="?attr/colorControlHighlight"
    tools:text="Gaming" />