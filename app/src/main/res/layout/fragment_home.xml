<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <HorizontalScrollView
            android:id="@+id/home_chip_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/header_bg"
            android:scrollbars="none"
            android:elevation="0dp"
            android:fillViewport="true">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/home_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/header_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:elevation="0dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="8dp" />
        </HorizontalScrollView>

        <org.schabi.newpipe.views.skeleton.PlayTubeShimmerContainer
            android:id="@+id/home_chip_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/header_bg"
            android:visibility="gone">

            <include layout="@layout/layout_skeleton_chips" />
        </org.schabi.newpipe.views.skeleton.PlayTubeShimmerContainer>
    </FrameLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>