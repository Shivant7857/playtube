<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Row 1: Avatar + Username/Timestamp + Overflow Menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/itemThumbnailView"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_person"
            app:shapeAppearance="@style/CircularImageView"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/detail_pinned_view"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_pin"
            android:visibility="gone"
            app:tint="#AAAAAA"
            tools:ignore="ContentDescription" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/itemTitleView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#AAAAAA"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="@AaravSingh • 21 hr ago" />

        <ImageView
            android:id="@+id/itemOverflowMenu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_more_vert"
            app:tint="#888888"
            android:background="?attr/selectableItemBackgroundBorderless"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Row 2: Comment Content Text -->
    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/itemCommentContentView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginTop="4dp"
        android:textColor="@android:color/white"
        android:textSize="13.5sp"
        android:lineSpacingExtra="2.5dp"
        tools:text="Imagine if google is also monitoring us 😆" />

    <!-- Row 3: Reply Connector and Interaction Row -->
    <LinearLayout
        android:id="@+id/interaction_row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <org.schabi.newpipe.views.CommentConnectorView
            android:id="@+id/comment_connector_view"
            android:layout_width="44dp"
            android:layout_height="26dp" />

        <LinearLayout
            android:id="@+id/replies_like_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/replies_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:textColor="#3EA6FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                app:drawableEndCompat="@drawable/ic_expand_more"
                app:drawableTint="#3EA6FF"
                android:drawablePadding="2dp"
                tools:text="28 replies" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/replies_bullet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="•"
                android:textColor="#666666"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/detail_thumbs_up_img_view"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_thumb_up"
                app:tint="#888888"
                tools:ignore="ContentDescription" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/detail_thumbs_up_count_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                tools:text="178" />

            <ImageView
                android:id="@+id/detail_heart_image_view"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_heart"
                android:visibility="gone"
                app:tint="#FF0000"
                tools:ignore="ContentDescription" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
